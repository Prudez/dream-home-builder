DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional: comma-separated list, overrides the built-in default entirely
# (dev CLIENT_ORIGIN + https://bluefalconreal.com + https://www.bluefalconreal.com)
# when set. Use this in production to lock the allow-list to the real domain.
# An entry may use `*` as a wildcard to cover Vercel preview deployments,
# e.g. https://*.vercel.app matches https://my-app-git-branch-abc123.vercel.app.
ALLOWED_ORIGINS=http://localhost:5173,https://bluefalconreal.com,https://www.bluefalconreal.com,https://*.vercel.app
